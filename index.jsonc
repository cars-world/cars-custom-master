{
  "name": "@cars-world/cars-custom-master",
  "summary": "Master of the custom side of the cars example app, where released catalogs are edited further for customers; so far an HTTP server with GET / and GET /api/hello (its greeting) and GET /health; runs as a container in the stages dev, test and prod.",
  "domain": [
    "master of the custom side: later holds all data of the side, on @rljson/server",
    "container cars-custom-master, Node, uid 1000, port 3000",
  ],
  "interfaces": {
    "uses": {
      "cars-deployment": "the reusable workflow build: deploys the image of custom-master to dev on a push to main"
    },
    "usedBy": {
      "cars-custom-client": "GET /api/hello over HTTP",
    },
  },
}
